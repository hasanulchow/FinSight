# Copy to .env. EXPO_PUBLIC_ values are bundled into the app, so only public keys go here.

# Supabase (Project Settings -> API): URL and the anon/public key - NOT the service-role key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Node API. On a phone, "localhost" is the phone itself: use your computer's LAN IP
# (e.g. http://192.168.1.20:3001) or the deployed Render URL.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
