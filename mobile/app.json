{
  "expo": {
    "name": "FinSight",
    "slug": "finsight",
    "version": "1.5.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "finsight",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finsight.app",
      "requireFullScreen": false
    },
    "android": {
      "package": "com.finsight.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ]
    ]
  }
}
