# Copy to .env and fill in. Never commit .env.

PORT=3001

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
EVAL_MODEL=claude-sonnet-5-5

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub (https://finnhub.io, free tier)
FINNHUB_API_KEY=

# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=FinSight Research your-email@example.com

# Embeddings for filing search (optional, https://dash.voyageai.com).
# Without a key, Filing Q&A falls back to keyword search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4

# Guardrails: per-user limits per rolling hour
BRIEFINGS_PER_HOUR=20
QUESTIONS_PER_HOUR=60
AI_TOOLS_PER_HOUR=30

# Price history for technical analysis, the screener and indicator alerts
# (Massive, formerly Polygon.io: https://massive.com). The free tier allows ~5 calls/minute.
MASSIVE_API_KEY=
PRICES_RPM=5

# Scheduled jobs: alerts, screener refresh (SCREENER_BATCH tickers per run), daily portfolio digests
# Long-running servers: set an interval. Serverless (Vercel): Vercel Cron calls /jobs/run with CRON_SECRET.
JOBS_INTERVAL_MINUTES=0
CRON_SECRET=
SCREENER_BATCH=10
