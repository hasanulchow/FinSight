# Copy to .env and fill in. Never commit .env.

PORT=3001

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
EVAL_MODEL=claude-sonnet-5-5

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub (https://finnhub.io, free tier)
FINNHUB_API_KEY=

# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=FinSight Research your-email@example.com

# Embeddings for filing search (optional, https://dash.voyageai.com).
# Without a key, Filing Q&A falls back to keyword search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4

# Guardrails: per-user limits per rolling hour
BRIEFINGS_PER_HOUR=20
QUESTIONS_PER_HOUR=60
AI_TOOLS_PER_HOUR=30

# Price history for technical analysis, the screener and indicator alerts
# (Massive, formerly Polygon.io: https://massive.com). The free tier allows ~5 calls/minute.
MASSIVE_API_KEY=
PRICES_RPM=5

# Scheduled jobs: alerts, screener refresh (SCREENER_BATCH tickers per run), daily portfolio digests
# Long-running servers: set an interval. Serverless (Vercel): Vercel Cron calls /jobs/run with CRON_SECRET.
JOBS_INTERVAL_MINUTES=0
CRON_SECRET=
SCREENER_BATCH=10

# Billing (Stripe, optional). Without these everyone is on the Free plan and upgrades are hidden.
# Create a recurring Price for Pro in Stripe, and a webhook to <APP_URL>/billing/webhook for
# checkout.session.completed and customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
APP_URL=http://localhost:3001

# Plan limits per day (optional overrides)
# FREE_BRIEFINGS_PER_DAY=3
# FREE_COPILOT_PER_DAY=15
# FREE_AI_TOOLS_PER_DAY=10
# PRO_BRIEFINGS_PER_DAY=40
# PRO_COPILOT_PER_DAY=300
# Local mode only: test as a Free user
# DEV_PLAN=free

# Free trial for the first Pro subscription (days, 0 = none) and the price shown in admin MRR
TRIAL_DAYS=7
PRO_PRICE_MONTHLY=19
# Referrals: Pro days each side gets per signup, and the max rewarded signups per referrer
# REFERRAL_PRO_DAYS=14
# MAX_REFERRAL_REWARDS=10

# Broker sync (optional, https://snaptrade.com): read-only import of positions and trades
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Key for encrypting broker secrets at rest (any long random string). Defaults to one derived from the consumer key.
ENCRYPTION_KEY=

# Product analytics (optional, https://posthog.com): server-side events only
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Founder dashboard: comma-separated emails that can open Admin
ADMIN_EMAILS=

# AI cost tracking uses list prices for the model; override if your rates differ (USD per million tokens)
# AI_INPUT_USD_PER_MTOK=2
# AI_OUTPUT_USD_PER_MTOK=10

# Paper trading starting balance
# PAPER_STARTING_CASH=100000

# Real-money trading through the user's own broker (SnapTrade trading plan + legal review first)
BROKER_TRADING_ENABLED=false

# Weekly email reports (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=FinSight <reports@yourdomain.com>

# Billing extras: yearly price, display labels, cancel-flow coupon
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_RETENTION_COUPON=
# PRO_PRICE_LABEL=$19/mo
# PRO_ANNUAL_PRICE_LABEL=$190/yr

# Error monitoring (https://sentry.io)
SENTRY_DSN=

# Rate limits per IP per minute
# RATE_LIMIT_PER_MIN=240
# RATE_LIMIT_WRITES_PER_MIN=60
