{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server && npm ci --prefix mobile",
  "buildCommand": "npm run build:web --prefix mobile",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/briefings", "destination": "/api" },
    { "source": "/briefings/:path*", "destination": "/api" },
    { "source": "/memory", "destination": "/api" },
    { "source": "/memory/:path*", "destination": "/api" },
    { "source": "/evals/:path*", "destination": "/api" },
    { "source": "/stocks/:path*", "destination": "/api" },
    { "source": "/alerts", "destination": "/api" },
    { "source": "/alerts/:path*", "destination": "/api" },
    { "source": "/notifications", "destination": "/api" },
    { "source": "/notifications/:path*", "destination": "/api" },
    { "source": "/push/:path*", "destination": "/api" },
    { "source": "/screener", "destination": "/api" },
    { "source": "/screener/:path*", "destination": "/api" },
    { "source": "/portfolio", "destination": "/api" },
    { "source": "/portfolio/:path*", "destination": "/api" },
    { "source": "/jobs/:path*", "destination": "/api" }
  ],
  "crons": [
    { "path": "/jobs/run", "schedule": "30 21 * * 1-5" }
  ]
}
