    {
      "source": "/broker/:path*",
      "destination": "/api"
    },
    {
      "source": "/share/:path*",
      "destination": "/api"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/jobs/run",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/jobs/run",
      "schedule": "30 21 * * 1-5"
    }
  ]
}
