{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server && npm ci --prefix mobile",
  "buildCommand": "npm run build:web --prefix mobile",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/briefings",
      "destination": "/api"
    },
    {
      "source": "/briefings/:path*",
      "destination": "/api"
    },
    {
      "source": "/memory",
      "destination": "/api"
    },
    {
      "source": "/memory/:path*",
      "destination": "/api"
    },
    {
      "source": "/evals/:path*",
      "destination": "/api"
    },
    {
      "source": "/stocks/:path*",
      "destination": "/api"
    },
    {
      "source": "/alerts",
      "destination": "/api"
    },
    {
      "source": "/alerts/:path*",
      "destination": "/api"
    },
    {
      "source": "/notifications",
      "destination": "/api"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/api"
    },
    {
      "source": "/push/:path*",
      "destination": "/api"
    },
    {
      "source": "/screener",
      "destination": "/api"
    },
    {
      "source": "/screener/:path*",
      "destination": "/api"
    },
    {
      "source": "/portfolio",
      "destination": "/api"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/api"
    },
    {
      "source": "/jobs/:path*",
      "destination": "/api"
    },
    {
      "source": "/options/:path*",
      "destination": "/api"
    },
    {
      "source": "/backtest/:path*",
      "destination": "/api"
    },
    {
      "source": "/market/:path*",
      "destination": "/api"
    },
    {
      "source": "/plans",
      "destination": "/api"
    },
    {
      "source": "/account",
      "destination": "/api"
    },
    {
      "source": "/billing/:path*",
      "destination": "/api"
    },
    {
      "source": "/copilot/:path*",
      "destination": "/api"
    },
    {
      "source": "/journal",
      "destination": "/api"
    },
    {
      "source": "/journal/:path*",
      "destination": "/api"
    },
    {
      "source": "/risk/:path*",
      "destination": "/api"
    },
    {
      "source": "/settings",
      "destination": "/api"
    },
    {
      "source": "/onboarding",
      "destination": "/api"
    },
    {
      "source": "/referrals",
      "destination": "/api"
    },
    {
      "source": "/account/:path*",
      "destination": "/api"
    },
    {
      "source": "/events",
      "destination": "/api"
    },
    {
      "source": "/watchlist",
      "destination": "/api"
    },
    {
      "source": "/watchlist/:path*",
      "destination": "/api"
    },
    {
      "source": "/brief",
      "destination": "/api"
    },
    {
      "source": "/brief/:path*",
      "destination": "/api"
    },
    {
      "source": "/automations",
      "destination": "/api"
    },
    {
      "source": "/automations/:path*",
      "destination": "/api"
    },
    {
      "source": "/rules",
      "destination": "/api"
    },
    {
      "source": "/tax/:path*",
      "destination": "/api"
